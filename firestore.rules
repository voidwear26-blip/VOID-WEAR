rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- System Authority Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        // 1. Master UID Authority
        request.auth.uid in [
          'A9vsqn10oddfmouKiKjWpTcFqZB2', 
          '0LvBBO9ySQdBKr3uwjcAjphMM8x1'
        ] ||
        // 2. Master Email Authority
        (request.auth.token.email != null && 
         request.auth.token.email.lower() in [
           'voidwear26@gmail.com', 
           'shahabuddinosaid@gmail.com', 
           'voidwearoff26@gmail.com'
         ]) ||
        // 3. Database Role Authority
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER OVERRIDE: Full Admin Control ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Public & Restricted Access Rules ---
    match /products/{productId} {
      allow read: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow create: if true;
    }

    match /app_config/{configId} {
      allow read: if true;
    }

    match /stories/{storyId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow get, list, create, update: if isOwner(userId);

      match /carts/{cartId} {
        allow read, write: if isOwner(userId);
        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}