rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- System Authority Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Robust admin check: Master list OR Database role
    function isAdmin() {
      if (!isSignedIn()) return false;
      
      // 1. Master List Check (Instant, no document reads)
      let masterUIDs = [
        'A9vsqn10oddfmouKiKjWpTcFqZB2', 
        '0LvBBO9ySQdBKr3uwjcAjphMM8x1'
      ];
      let masterEmails = [
        'voidwear26@gmail.com', 
        'shahabuddinosaid@gmail.com', 
        'voidwearoff26@gmail.com'
      ];
      
      if (request.auth.uid in masterUIDs) return true;
      if (request.auth.token.email != null && request.auth.token.email.lower() in masterEmails) return true;
      
      // 2. Database Role Check (Safely handled with default fallback)
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDocPath) && get(userDocPath).data.get('role', 'OPERATOR') == 'ADMIN';
    }

    // --- Product & Catalog Rules ---
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn(); // Required for stock decrement or admin edits
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User-Specific Data Rules ---
    match /users/{userId} {
      // Users can manage their own profile
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Nested resources (Orders, Carts, Wishlist)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Feedback & Communication ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Collection Group Rules ---
    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }
  }
}