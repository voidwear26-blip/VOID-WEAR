rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Identity Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    // High-speed authority check using token metadata
    function isAdmin() {
      if (!isSignedIn()) return false;
      
      let masterUIDs = [
        'A9vsqn10oddfmouKiKjWpTcFqZB2', 
        '0LvBBO9ySQdBKr3uwjcAjphMM8x1'
      ];
      let masterEmails = [
        'voidwear26@gmail.com', 
        'shahabuddinosaid@gmail.com', 
        'voidwearoff26@gmail.com'
      ];
      
      let email = request.auth.token.get('email', '').lower();
      return (request.auth.uid in masterUIDs) || (email in masterEmails);
    }

    // --- Product & Catalog Nodes ---
    match /products/{productId} {
      allow read: if true;
      allow update: if isSignedIn(); // Required for stock decrement during purchase
      allow create, delete, write: if isAdmin();
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User-Specific Archives (Profile, Orders, Carts, Wishlist) ---
    // Using explicit paths to prevent recursive wildcard evaluation errors in transactions.
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /orders/{orderId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
      
      match /carts/{cartId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        match /items/{itemId} {
           allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        }
      }
      
      match /wishlist/{itemId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Communication & Feedback ---
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- Collection Group Access ---
    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}