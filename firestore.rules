rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- System Authority Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Robust admin check: Master list OR Database role
    function isAdmin() {
      if (!isSignedIn()) return false;
      
      // 1. Master List Check (Instant, no document reads)
      let masterUIDs = [
        'A9vsqn10oddfmouKiKjWpTcFqZB2', 
        '0LvBBO9ySQdBKr3uwjcAjphMM8x1'
      ];
      let masterEmails = [
        'voidwear26@gmail.com', 
        'shahabuddinosaid@gmail.com', 
        'voidwearoff26@gmail.com'
      ];
      
      if (request.auth.uid in masterUIDs) return true;
      if (request.auth.token.email != null && request.auth.token.email.lower() in masterEmails) return true;
      
      // 2. Database Role Check (Safely handled with default fallback)
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDocPath) && get(userDocPath).data.get('role', 'OPERATOR') == 'ADMIN';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER OVERRIDE: Full Admin Control ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Public & Restricted Access Rules ---
    match /products/{productId} {
      allow read: if true;
      allow update: if isSignedIn(); // Required for stock decrement during purchase
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow create: if true;
    }

    match /app_config/{configId} {
      allow read: if true;
    }

    match /stories/{storyId} {
      allow read: if true;
    }

    match /users/{userId} {
      // Owners can manage their own dossier and sub-resources
      allow read, write: if isOwner(userId);
      
      match /carts/{cartId} {
        allow read, write: if isOwner(userId);
        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Collection Group Rule for Orders (Admin monitoring + User history)
    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Collection Group Rule for Reviews
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }
  }
}